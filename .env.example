# ============================================================
# Video Creator Studio (Local-First + Google AI Stack) Config
# 复制本文件为 .env 并填入你的密钥（也可启动后在网页右上角“设置”中直接配置）
# ============================================================

# 1. 运行模式: "auto" (有Key自动走Live, 无Key走Demo) | "live" | "demo"
APP_MODE=auto

# 2. Gemini API Key (从 Google AI Studio 获取，可使用 Google AI Ultra 月度开发者额度)
# 用于: Gemini 4 导演/编剧/审片, Nano Banana 2.1 生图, Gemini Omni 1.2 视频, Lyria 3.5 配乐
GEMINI_API_KEY=

# 3. GPT / OpenAI 兼容生图配置（推荐用于角色定妆照 & 三视图，可填中转站 URL）
# IMAGE_PROVIDER: "gemini" | "openai_assets"(仅定妆照+三视图用GPT) | "openai_all"(全部生图用GPT)
IMAGE_PROVIDER=gemini
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_MAX_CONCURRENT=2

# 4. 默认模型配置 (2026 Google 官方最新模型栈，可根据可用性调整)
TEXT_MODEL=gemini-4-hydrogen
IMAGE_MODEL=gemini-nano-banana-2.1
OMNI_VIDEO_MODEL=gemini-omni-1.2-flash
MUSIC_MODEL=lyria-3.5

# 5. 并发与超时配置
MAX_CONCURRENT_JOBS=3
VIDEO_REQUEST_TIMEOUT=900

# 6. 月度预算警戒线 (美元, Ultra 5x 建议设为 40, Ultra 20x 设为 100)
MONTHLY_BUDGET_USD=40.0

# 6. Docker 宿主机访问端口（默认 3000）
STUDIO_PORT=3000

# 7. 公网登录鉴权配置（默认开启；本地纯离线调试可改为 false）
AUTH_ENABLED=true
SESSION_TTL_DAYS=14
# 可选：若不填则首次打开网页时直接由管理员界面创建；若提前填写且数据库无用户，启动时自动初始化
ADMIN_USERNAME=
ADMIN_PASSWORD=
