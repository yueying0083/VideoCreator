# ============================================================
# Video Creator Studio (Local-First + Google AI Stack) Config
# 复制本文件为 .env 并填入你的密钥（也可启动后在网页右上角“设置”中直接配置）
# ============================================================

# 1. 运行模式: "auto" (有Key自动走Live, 无Key走Demo) | "live" | "demo"
APP_MODE=auto

# 2. Gemini API Key (从 Google AI Studio 获取，可使用 Google AI Ultra 月度开发者额度)
# 用于: Gemini 导演/编剧/审片, Nano Banana 2 生图, Gemini Omni 视频, Lyria 3 配乐
GEMINI_API_KEY=

# 3. Vertex AI 配置 (可选，但调用 Veo 3.1 GA 正式版视频模型需要)
# 在 Google Cloud Console 创建项目并绑定 Ultra 领取的开发者抵扣金结算账号
VERTEX_PROJECT_ID=
VERTEX_LOCATION=us-central1
# 服务账号 JSON 路径 (留空则使用 gcloud ADC 默认凭据)
GOOGLE_APPLICATION_CREDENTIALS=

# 4. 默认模型配置 (可根据 Google 最新可用模型调整)
TEXT_MODEL=gemini-2.5-flash
IMAGE_MODEL=gemini-3.1-flash-image
OMNI_VIDEO_MODEL=gemini-omni-1.2-flash
VEO_LITE_MODEL=veo-3.1-lite-generate-001
VEO_FAST_MODEL=veo-3.1-fast-generate-001
VEO_STANDARD_MODEL=veo-3.1-generate-001
MUSIC_MODEL=lyria-3-clip-preview

# 5. 月度预算警戒线 (美元, Ultra 5x 建议设为 40, Ultra 20x 设为 100)
MONTHLY_BUDGET_USD=40.0

# 6. Docker 宿主机访问端口（默认 3000）
STUDIO_PORT=3000
